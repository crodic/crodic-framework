                <table class="button-table" role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-top:28px;">
                  <tr>
                    <td align="center" bgcolor="#7c3aed" style="background-color:#7c3aed;border-radius:8px;mso-padding-alt:14px 24px;">
                      <a class="email-button" href="{{url}}" target="_blank" style="display:inline-block;padding:14px 24px;border:1px solid #7c3aed;border-radius:8px;color:#ffffff;background-color:#7c3aed;font-size:16px;line-height:20px;font-weight:700;text-decoration:none;mso-padding-alt:0;text-underline-color:#7c3aed;"><!--[if mso]><i style="mso-font-width:100%;mso-text-raise:21pt;" hidden>&emsp;</i><span style="mso-text-raise:10pt;"><![endif]-->{{label}}<!--[if mso]></span><i style="mso-font-width:100%;" hidden>&emsp;&#8203;</i><![endif]--></a>
                    </td>
                  </tr>
                </table>
                {{#if note}}<p style="margin:24px 0 0;font-size:14px;line-height:22px;color:#52525b;">{{note}}</p>{{/if}}
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top:28px;">
                  <tr>
                    <td style="border-top:1px solid #e4e4e7;padding-top:24px;">
                      <p style="margin:0;font-size:13px;line-height:21px;color:#52525b;">Không mở được nút? Sao chép liên kết này vào trình duyệt:</p>
                      <p style="margin:8px 0 0;font-size:13px;line-height:21px;word-break:break-all;overflow-wrap:anywhere;">
                        <a href="{{url}}" target="_blank" style="color:#6d28d9;text-decoration:underline;word-break:break-all;overflow-wrap:anywhere;">{{url}}</a>
                      </p>
                    </td>
                  </tr>
                </table>
