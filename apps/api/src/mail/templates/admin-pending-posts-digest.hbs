<html lang='vi'>
  <body
    style='margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#0f172a;'
  >
    <table
      role='presentation'
      width='100%'
      cellspacing='0'
      cellpadding='0'
      style='background:#f1f5f9;'
    >
      <tr>
        <td align='center' style='padding:40px 16px;'>
          <table
            role='presentation'
            width='100%'
            cellspacing='0'
            cellpadding='0'
            style='max-width:640px;background:#ffffff;border:1px solid #cbd5e1;border-radius:24px;overflow:hidden;box-shadow:0 20px 40px rgba(15,23,42,0.08);'
          >
            <!-- Header -->
            <tr>
              <td style='padding:28px 36px;background:#0f172a;'>
                <table role='presentation' width='100%' cellspacing='0' cellpadding='0'>
                  <tr>
                    <td>
                      <span
                        style='display:inline-block;padding:6px 14px;background:#2563eb;color:#ffffff;font-size:14px;font-weight:700;border-radius:8px;letter-spacing:0.05em;'
                      >KOSUME</span>
                    </td>
                    <td align='right'>
                      <span
                        style='border:1px solid rgba(255,255,255,0.25);border-radius:999px;color:#cbd5e1;font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:6px 12px;'
                      >Hàng Đợi Kiểm Duyệt</span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style='padding:36px 36px 16px;'>
                <h1
                  style='margin:0;color:#0f172a;font-size:26px;line-height:34px;font-weight:800;'
                >Báo cáo bài viết chờ duyệt hàng ngày</h1>
                <p
                  style='margin:14px 0 0;color:#475569;font-size:15px;line-height:24px;'
                >Xin chào Ban Quản Trị Kosume,</p>
                <p
                  style='margin:8px 0 0;color:#475569;font-size:15px;line-height:24px;'
                >Hệ thống ghi nhận vào ngày <strong>{{currentDate}}</strong>, số lượng bài viết của cộng đồng đang ở trạng thái chờ duyệt đã vượt ngưỡng <strong>10 bài viết</strong>.</p>
              </td>
            </tr>

            <!-- Metric Box -->
            <tr>
              <td style='padding:0 36px 16px;'>
                <div
                  style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:16px;padding:24px;text-align:center;'
                >
                  <div style='color:#64748b;font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;'>Số bài viết đang chờ phê duyệt</div>
                  <div style='color:#e11d48;font-size:48px;font-weight:900;line-height:56px;margin:8px 0;'>{{pendingCount}}</div>
                  <div style='color:#64748b;font-size:13px;'>Yêu cầu kiểm duyệt nội dung theo tiêu chuẩn cộng đồng và cosplay</div>
                </div>
              </td>
            </tr>

            <!-- Call to action -->
            <tr>
              <td style='padding:12px 36px 24px;text-align:center;'>
                <a
                  href='{{reviewUrl}}'
                  target='_blank'
                  style='display:inline-block;padding:14px 32px;background:#2563eb;color:#ffffff;font-size:15px;font-weight:700;text-decoration:none;border-radius:12px;box-shadow:0 4px 12px rgba(37,99,235,0.25);'
                >Mở trang kiểm duyệt bài viết ngay &rarr;</a>
              </td>
            </tr>

            <!-- Note / Explanations -->
            <tr>
              <td style='padding:0 36px 28px;'>
                <div
                  style='padding:14px 18px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:12px;color:#1e40af;font-size:13px;line-height:20px;'
                >
                  <strong>💡 Lưu ý:</strong> Email này được gửi gộp tự động (sử dụng chế độ To + CC) đến tất cả Quản trị viên đã bật tính năng nhận email thông báo. Nếu bài viết không phải chủ đề cosplay hoặc vi phạm từ khóa cấm, bạn có thể từ chối kèm lý do phản hồi cho tác giả.
                </div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style='padding:20px 36px;background:#f8fafc;border-top:1px solid #e2e8f0;color:#94a3b8;font-size:12px;line-height:18px;text-align:center;'
              >
                Kosume Framework Content Moderation Service &bull; Hệ thống tự động kiểm soát chất lượng nội dung
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
